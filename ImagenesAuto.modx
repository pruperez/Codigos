    !Posiciones inspección MODIFICAR!!!!    
    CONST robtarget InspPos:=[[-74.07,632.38,58.85],[0.278931,0.64923,0.649453,0.280907],[1,-1,-2,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget InspPosB:=[[-74.05,632.37,180.17],[0.27894,0.649232,0.649449,0.280903],[1,-1,-2,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget InspCam:=[[27.2267609834671, 546.330809593201, 95.9743782877922], [0.270422071218491, -0.649103462696075, -0.659166753292084, 0.266525328159332], [0, 0, -3, 0], [9000000000, 9000000000, 9000000000, 9000000000, 9000000000, 9000000000]];
    CONST robtarget InspPosSs:=[[-74.38,631.21,59.29],[0.276096,-0.647984,0.65297,-0.278418],[1,-1,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget InspPosSsB:=[[-74.36,631.21,178.19],[0.276085,-0.647977,0.652975,-0.278436],[1,-1,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget InspHome:=[[-14.1480211168528, 611.883819103241, 219.765678048134], [0.0000906013592611998, 0.72039932012558, 0.693559527397156, -0.0000818307089502923], [1, -1, -2, 0], [9000000000, 9000000000, 9000000000, 9000000000, 9000000000, 9000000000]];
    
    !Definir números de cristales    
    CONST num numCristalStock{3,10}:=[[0243,0213,0256,0333,0318,0310,0316,0093,0100,0312],[0324, 0323, 0216, 0299, 0095, 0140, 0248, 0273, 0030, 0079],[0028, 0180, 0222, 0148, 0155, 0166, 0275, 0232, 0138, 0221]];
    
     !Inicialización cámara
    VAR cameradev is7600_M;
    VAR socketdev socket_cam;

    VAR signaldo do_camera_led;
    VAR num numcrist1; !Cristales del stock 1
    VAR num numcrist2; !Cristales del stcok 2
    VAR num numcrist3; !Cristales del stock 3
    
    
    PROC imagenauto()

        AliasIO ABB_Scalable_IO_0_DO3, do_camera_led;
        AccSet 50,50;
        
        MoveJ HomePos, v100, z50, Match_F;
        iteration := 0;
        
        WHILE iteration < 30 DO
            Incr iteration;
            numcrist1 := 1;
            numcrist2 := 1;
            numcrist3 := 1;
            WHILE numcrist3 <= 10 DO
    
                ! =========================
               ! STOCK 1
                ! =========================
                IF numcrist1 <= 10 AND numcrist2 = 1 AND numcrist3 = 1 THEN
                
            
                    Inspect_Stock1;
            
                    Incr numcrist1;
            
                ! =========================
                ! STOCK 2
                ! =========================
                ELSEIF numcrist2 <= 10 AND numcrist1>10 AND numcrist3 = 1 THEN
            
                    Inspect_Stock2;
            
                    Incr numcrist2;
            
                ! =========================
                ! STOCK 3
                ! =========================
                ELSEIF numcrist3 <= 10 AND numcrist1>10 AND numcrist2>10 THEN
            
                    Inspect_Stock3;
            
                    Incr numcrist3;
            
                ENDIF
            ENDWHILE  
        ENDWHILE
    ENDPROC
    PROC Inspect_Stock1()
        openGripper;
    
        ! Coger cristal de Stock1
        MoveJ Stock1b{numcrist1}, v100, z50, Match_F;
        MoveL Stock1{numcrist1}, v50, fine, Match_F;
        closeGripper;
        WaitTime 0.5;
        MoveL Stock1b{numcrist1}, v50, z50, Match_F;
        MoveJ InspHome, v100, z50, Match_F;
        MoveJ InspPosB, v100, z50, Match_F;
        MoveL InspPos, v50, fine, Match_F;
        openGripper;
        WaitTime 0.5;
        MoveJ InspPosB, v50, z50, Match_F;
        MoveJ InspHome, v100, z50, Match_F;
    
        ! Foto primera cara
        MoveJ InspCam, v50, fine, Match_F;
        
        TakePhotos 1, numcrist1,  "a", iteration;
        
        ! Volver a cogerlo con pinza girada
        MoveJ InspHome, v100, z50, Match_F;
        MoveJ InspPosSsB, v50, z50, Match_F;
        MoveL InspPosSs, v50, fine, Match_F;
        closeGripper;
        WaitTime 0.5;
        MoveL InspPosSsB, v50, z50, Match_F;
        
        ! Ir a home con el cristal girado
        MoveJ InspHome, v100, z50, Match_F;
    
        ! Volver a dejarlo en inspeccion, ya girado
        MoveJ InspPosB, v100, z50, Match_F;
        MoveL InspPos, v50, fine, Match_F;
        openGripper;
        WaitTime 0.5;
        MoveJ InspPosB, v50, z50, Match_F;
        MoveJ InspHome, v100, z50, Match_F;
    
        ! Foto segunda cara
        MoveJ InspCam, v50, fine, Match_F;
        WaitTime 0.5;
        
        TakePhotos 1, numcrist1, "b", iteration;
        
        ! Cogerlo normal otra vez girado a posicion inicial
        MoveJ InspHome, v100, z50, Match_F;
        MoveJ InspPosSsB, v50, z50, Match_F;
        MoveL InspPosSs, v50, fine, Match_F;
        closeGripper;
        WaitTime 0.5;
        MoveL InspPosSsB, v50, z50, Match_F;
    
        ! Devolverlo a su sitio inicial
        MoveJ InspHome, v100, z50, Match_F;
        MoveJ Stock1b{numcrist1}, v100, z50, Match_F;
        MoveL Stock1{numcrist1}, v50, fine, Match_F;
        openGripper;
        WaitTime 0.5;
        MoveL Stock1b{numcrist1}, v50, z50, Match_F;
    
    ENDPROC
    
    PROC Inspect_Stock2()
        openGripper;
    
        ! Coger cristal de Stock2
