        WaitTime 0.5;
        MoveL InspPosSsB, v50, z50, Match_F;
    
        ! Devolverlo a su sitio inicial
        MoveJ InspHome, v100, z50, Match_F;
        MoveJ Stock3b{numcrist3}, v100, z50, Match_F;
        MoveL Stock3{numcrist3}, v50, fine, Match_F;
        openGripper;
        WaitTime 0.5;
        MoveL Stock3b{numcrist3}, v50, z50, Match_F;
    
    ENDPROC
    
    PROC TakePhotos(num posStock_x, num posStock_y, string tipoFoto, num niteration)
        VAR num idCristal;
        VAR string nombreFoto;
        idCristal := numCristalStock{posStock_x, posStock_y};
        CamSetProgramMode is7600_M;

        SetDO do_camera_led,1;
        WaitTime 0.5;
        nombreFoto:= "Foto_" + NumToStr(idCristal,0) + "_" + tipoFoto + "_iter_" + NumToStr(niteration,0);
        !MoveJ HomePos, v100, fine, Match_F;
        !MoveJ InspCam, v100, fine, Match_F;
        CamLoadJob is7600_M, "Foto.job";
        CamSetRunMode is7600_M;
        CamSetParameter is7600_M, "B20"\StrVal:=nombreFoto;
        CamReqImage is7600_M;
        CamGetResult is7600_M, camTarget;
        CamSetRunMode is7600_M;
        TPWrite "Imagen capturada:"+ nombreFoto;
        SetDO do_camera_led,0;
    ENDPROC
ENDMODULE
